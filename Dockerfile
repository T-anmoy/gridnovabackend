# Grid Nova backend — the image Cloud Run serves AND the image the migration job runs
# (deploy/RUNBOOK.md). Runtime only: no tests, no pytest, no NeMo Guardrails.
FROM python:3.12-slim-bookworm

# PYTHONUNBUFFERED: logs reach Cloud Logging as they are written, not when a buffer fills
# (or never, if the instance is killed). PYTHONDONTWRITEBYTECODE: the app directory is
# read-only to the runtime user, so no .pyc writes are attempted. XDG_CACHE_HOME: the
# runtime user has no home directory; fontconfig's per-user cache goes to /tmp (the
# system font cache is built below, at build time).
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    XDG_CACHE_HOME=/tmp/.cache \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# WeasyPrint's native libraries (Pango + HarfBuzz subsetting; WeasyPrint >= 53 needs no
# cairo or gdk-pixbuf), and fonts for every script a name can be written in:
#   fonts-liberation  Liberation Sans, metric-compatible with Arial (Latin)
#   fonts-noto-core   Noto Sans incl. Devanagari and Bengali
# Without the Noto fonts, Hindi and Bengali names print as empty boxes (app/pdf/fonts.py;
# scripts/smoke_fonts.py checks it against the built image).
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz-subset0 fontconfig \
        fonts-liberation fonts-noto-core \
    && fc-cache -f \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Exactly the locked versions, every file checked against its hash (requirements.lock is
# generated by scripts/lock_requirements.sh from requirements.txt).
COPY requirements.lock .
RUN pip install --require-hashes --no-deps -r requirements.lock

COPY . .

# Run as an unprivileged user that cannot modify the application code.
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin gridnova
USER gridnova

EXPOSE 8000

# One uvicorn process per container: Cloud Run scales by adding instances, and
# --concurrency (deploy/RUNBOOK.md) caps the requests one process takes at a time.
#
# `exec` makes uvicorn PID 1, so Cloud Run's SIGTERM reaches it; it then stops accepting
# connections and lets in-flight requests finish for up to --timeout-graceful-shutdown
# seconds (Cloud Run kills the container 10 s after SIGTERM, so this stays below that).
# The background job runner is drained in the app's lifespan shutdown (app/jobs/runner.py).
#
# Client IP behind Cloud Run: --proxy-headers stays on, but uvicorn trusts
# X-Forwarded-For only from FORWARDED_ALLOW_IPS (uvicorn's own env var, default
# 127.0.0.1). Behind Cloud Run the peer is Google's front end, so uvicorn leaves
# request.client alone — nothing in the app reads the request's own scheme or host. Do
# NOT set FORWARDED_ALLOW_IPS='*': uvicorn then takes the LEFTMOST X-Forwarded-For entry,
# which the visitor controls. The rate limiters read the visitor from the right-hand end
# of X-Forwarded-For instead: TRUSTED_PROXY_HOPS=1 directly behind Cloud Run, 2 behind an
# external HTTPS load balancer (app/security/client_ip.py).
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --proxy-headers --timeout-graceful-shutdown ${GRACEFUL_SHUTDOWN_SECONDS:-8}"]
