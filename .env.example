ENVIRONMENT=development
DATABASE_URL=sqlite:///./gridnova_dev.db
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER=
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
PROPOSAL_VALUE_MANAGER_APPROVAL_THRESHOLD=500000
CAPACITY_DIRECTOR_NOTIFY_THRESHOLD_MW=1.0
AI_ESTIMATED_COST_PER_CALL=0.01
# Google Calendar meeting scheduling (leave blank to keep scheduling inert)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Fernet key for encrypting employee Google refresh tokens at rest.
# Generate with: python -c "from app.security.encryption import generate_key; print(generate_key())"
FERNET_ENCRYPTION_KEY=
# Scheduling business hours (IST)
BUSINESS_HOURS_START_IST=10
BUSINESS_HOURS_END_IST=18
BUSINESS_DAYS=[0,1,2,3,4,5]
BUSINESS_TIMEZONE=Asia/Kolkata
SCHEDULING_DAYS_AHEAD=5
SCHEDULING_DEFAULT_DURATION_MINUTES=30
# Internal notifications: set to a Slack incoming-webhook URL to route alerts to Slack;
# leave blank for the log-only notifier.
SLACK_WEBHOOK_URL=
SENTRY_DSN=
ALLOWED_ORIGINS=["http://localhost:3000","https://www.gridnova.in"]
