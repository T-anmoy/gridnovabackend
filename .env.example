ENVIRONMENT=development
DATABASE_URL=sqlite:///./gridnova_dev.db
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER=
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
PROPOSAL_VALUE_MANAGER_APPROVAL_THRESHOLD=500000
CAPACITY_DIRECTOR_NOTIFY_THRESHOLD_MW=1.0
AI_ESTIMATED_COST_PER_CALL=0.01
# Google Calendar meeting scheduling (leave blank to keep scheduling inert)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Fernet key for encrypting employee Google refresh tokens at rest.
# Generate with: python -c "from app.security.encryption import generate_key; print(generate_key())"
FERNET_ENCRYPTION_KEY=
# Scheduling business hours (IST)
BUSINESS_HOURS_START_IST=10
BUSINESS_HOURS_END_IST=18
BUSINESS_DAYS=[0,1,2,3,4,5]
BUSINESS_TIMEZONE=Asia/Kolkata
SCHEDULING_DAYS_AHEAD=5
SCHEDULING_DEFAULT_DURATION_MINUTES=30
# Internal notifications: set to a Slack incoming-webhook URL to route alerts to Slack;
# leave blank for the log-only notifier.
SLACK_WEBHOOK_URL=
SENTRY_DSN=
ALLOWED_ORIGINS=["http://localhost:3000","https://www.gridnova.in"]
# Customer memory (episodic recall + self-reflection).
# Keyword retrieval is the default and costs nothing. Set MEMORY_SEMANTIC_SEARCH=true
# to also embed each memory and rank by meaning — that adds one embedding API call
# per memory written and per question asked.
MEMORY_SEMANTIC_SEARCH=false
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_RECALL_TOP_K=12
# Force a reflection after this many customer messages even if no milestone was hit.
MEMORY_REFLECT_EVERY_N_MESSAGES=12
# NeMo Guardrails: semantic check that a reply is not disclosing internal company
# information (pricing internals, approval thresholds, employees, other customers).
# Adds one LLM call per customer reply, so it is off by default. Requires LLM_API_KEY.
NEMO_GUARDRAILS_ENABLED=false
NEMO_GUARDRAILS_TIMEOUT_SECONDS=6
# On rail error/timeout: false sends the reply anyway (deterministic checks still
# applied), true withholds it and sends the safe fallback instead.
NEMO_GUARDRAILS_FAIL_CLOSED=false
# Agent governance. Kill switch: name any agent id to stop it acting, no deploy
# needed. Valid ids: sales_agent, proposal_agent, memory_agent.
DISABLED_AGENTS=[]
# Most agent replies one lead may receive in 24h before the conversation is handed
# to a person. 0 disables the limit.
AGENT_DAILY_ACTION_LIMIT_PER_LEAD=60
# Agent harness. A run slower than this is logged as slow (a warning, not a cut-off).
AGENT_SLOW_RUN_MS=8000
# Where agent time is actually bounded: the model client's request timeout/retries.
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
