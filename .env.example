# Grid Nova backend configuration. Values below are local-development defaults;
# "prod:" comments show a production example (never a real secret).
# With ENVIRONMENT=production or staging the app REFUSES TO START (app/config.py
# check_production_config) if: DATABASE_URL is not a PostgreSQL URL (or disables TLS over
# TCP); CLERK_JWT_ISSUER, CLERK_SECRET_KEY, FERNET_ENCRYPTION_KEY or IDENTITY_HMAC_KEY is
# empty; ALLOWED_ORIGINS has a localhost origin or an entry that is not exactly
# scheme://host; TRUSTED_PROXY_HOPS is 0; FRONTEND_BASE_URL or PUBLIC_API_BASE_URL is
# empty/local; and — in production only — LLM_API_KEY or INTERNAL_API_KEY is empty.
# Every staging/production secret is NEW: never reuse a value from a development .env
# (deploy/RUNBOOK.md §5).

# ── Core ─────────────────────────────────────────────────────────────────────
# Exactly one of development | test | staging | production (anything else stops the boot).
# staging and production close the dev X-Employee-Id auth bypass and run the startup guard. prod: production
# default: development
ENVIRONMENT=
# SQLAlchemy URL. prod: postgresql://gridnova:<password>@/gridnova?host=/cloudsql/<project>:asia-south1:<instance>
# default: sqlite:///./gridnova_dev.db
DATABASE_URL=
# PostgreSQL pool per instance (app/memory/db.py). Budget: (DB_POOL_SIZE + DB_MAX_OVERFLOW)
# × Cloud Run max instances (both services) + 5 must stay under Cloud SQL max_connections.
# default: 10
DB_POOL_SIZE=
# default: 5
DB_MAX_OVERFLOW=
# Seconds a request waits for a pooled connection before failing.
# default: 10
DB_POOL_TIMEOUT_SECONDS=
# Connections older than this (seconds) are replaced.
# default: 1800
DB_POOL_RECYCLE_SECONDS=
# JSON array of browser origins allowed by CORS — and the only values Clerk's `azp` claim
# may carry. Exactly scheme://host, no path, no trailing slash; list both www and apex if
# both are used, and the Vercel preview URL on staging (deploy/RUNBOOK.md §8).
# prod: ["https://www.gridnova.in","https://gridnova.in"]
# default: ["http://localhost:3000","https://www.gridnova.in"]
ALLOWED_ORIGINS=
# Where browser redirects land (e.g. after Google Calendar consent). prod: https://www.gridnova.in
# default: http://localhost:3000
FRONTEND_BASE_URL=
# This API's own public origin, used for links that point at it from outside (the
# customer email's PDF download). Blank = those links are left out. prod: https://api.gridnova.in
PUBLIC_API_BASE_URL=

# ── Auth (Clerk) ─────────────────────────────────────────────────────────────
# Required in staging/production. Clerk secret key (role sync, associate invitations; also the secret the calendar OAuth state key is derived from —
# FERNET_ENCRYPTION_KEY is used when this is blank, and with neither set the calendar
# connection cannot start). prod: sk_live_...
CLERK_SECRET_KEY=
# Clerk frontend API URL; JWTs are verified against its JWKS. Required in production. prod: https://clerk.gridnova.in
CLERK_JWT_ISSUER=
# Where Clerk sends an invited associate after they accept the invitation (the associate
# portal's sign-up page). Blank = Clerk's own default. prod: https://www.gridnova.in/associates/sign-up
ASSOCIATE_INVITE_REDIRECT_URL=
# Where Clerk sends an invited staff member after they accept (a dashboard page that
# completes Clerk's invitation sign-up, BE-17). Blank = Clerk's own sign-up page.
# prod: https://www.gridnova.in/dashboard/sign-up
STAFF_INVITE_REDIRECT_URL=

# ── Server-to-server / proxy ─────────────────────────────────────────────────
# Shared key sent as X-Internal-Key by the website lead mirror and Cloud Scheduler.
# Blank = feature off (required in production, warned in staging).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=
# Proxies that append to X-Forwarded-For, for rate-limit client IPs. 0 = use socket peer.
# prod: 1 (Cloud Run direct) or 2 (external HTTPS load balancer in front of Cloud Run)
# default: 0
TRUSTED_PROXY_HOPS=
# (uvicorn's own) addresses allowed to rewrite request.client from X-Forwarded-For.
# Leave at the default; never "*" (uvicorn then trusts the client-supplied leftmost entry).
# FORWARDED_ALLOW_IPS=127.0.0.1

# ── Storage (Cloudflare R2, S3-compatible) — warns in production if empty ────
# Bucket for proposal PDFs and uploaded documents. prod: gridnova-prod
STORAGE_BUCKET=
# R2 S3 endpoint. prod: https://<account-id>.r2.cloudflarestorage.com
STORAGE_ENDPOINT_URL=
# R2 access key id.
STORAGE_ACCESS_KEY=
# R2 secret access key.
STORAGE_SECRET_KEY=
# Lifetime (seconds) of the signed download links the API hands out; the bucket itself
# stays private. 60–604800.
# default: 600
STORAGE_SIGNED_URL_TTL_SECONDS=

# ── LLM — empty LLM_API_KEY = mock mode (refused in production, warns in staging) ─
# OpenAI-compatible API key. prod: sk-...
LLM_API_KEY=
# OpenAI-compatible base URL.
# default: https://api.openai.com/v1
LLM_BASE_URL=
# Chat model id.
# default: gpt-4o-mini
LLM_MODEL=
# Proposal Studio (BE-18): the optional "suggest from notes" assistant — customer / site /
# connection fields only, never prices. Off by default (no model call).
# default: false
STUDIO_AI_FILL_ENABLED=
# Where agent time is actually bounded: the model client's request timeout (seconds).
# default: 30
LLM_REQUEST_TIMEOUT_SECONDS=
# Transport-level retries per model call.
# default: 2
LLM_MAX_RETRIES=

# ── Business rules ───────────────────────────────────────────────────────────
# Proposal value (INR) above which manager sign-off is required.
# default: 500000
PROPOSAL_VALUE_MANAGER_APPROVAL_THRESHOLD=
# Capacity (MW) above which the director is notified.
# default: 1.0
CAPACITY_DIRECTOR_NOTIFY_THRESHOLD_MW=
# Estimated USD cost per AI reply, for /analytics ai_estimated_cost.
# default: 0.01
AI_ESTIMATED_COST_PER_CALL=

# ── Google Calendar meeting scheduling — inert until all three are set ───────
# OAuth client id. prod: <id>.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_ID=
# OAuth client secret.
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match the Google console. prod: https://<api-host>/api/v1/dashboard/employees/me/calendar/callback
GOOGLE_OAUTH_REDIRECT_URI=
# Fernet key(s) encrypting Google refresh tokens and associate bank account numbers at
# rest. Comma-separated, newest first (rotation: deploy/RUNBOOK.md §5.3). Required in production.
# Generate with: python -c "from app.security.encryption import generate_key; print(generate_key())"
FERNET_ENCRYPTION_KEY=
# Signs associate identity claims (duplicate-registration guard). Its own secret, so a
# Fernet rotation never touches it. Required in staging/production; blank in development
# falls back to the old Fernet-derived key. Changing it needs scripts/rehash_identity_claims.py.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
IDENTITY_HMAC_KEY=
# Slots are only offered inside business hours (IST, 24h clock).
# default: 10
BUSINESS_HOURS_START_IST=
# default: 18
BUSINESS_HOURS_END_IST=
# Business weekdays, Mon=0 (default Mon–Sat).
# default: [0,1,2,3,4,5]
BUSINESS_DAYS=
# Timezone the business hours are in.
# default: Asia/Kolkata
BUSINESS_TIMEZONE=
# How many days ahead slots are offered.
# default: 5
SCHEDULING_DAYS_AHEAD=
# Default meeting length (minutes).
# default: 30
SCHEDULING_DEFAULT_DURATION_MINUTES=

# ── Email notifications (Resend REST API) — off unless key AND sender are set ─
# Resend API key. prod: re_...
RESEND_API_KEY=
# Sender; its domain must be verified in Resend. prod: Grid Nova <notifications@gridnova.in>
NOTIFY_FROM_EMAIL=
# Comma-separated staff recipients for internal alerts; blank = no staff emails
# (customer proposal emails still go out). prod: sales@gridnova.in,ops@gridnova.in
STAFF_NOTIFY_EMAILS=
# Payment alerts (Accounts) and execution alerts (Operations); blank = STAFF_NOTIFY_EMAILS.
# Placeholder-registry entry P7 — the real addresses are still to come from Grid Nova.
ACCOUNTS_NOTIFY_EMAILS=
OPERATIONS_NOTIFY_EMAILS=
# Email associates about their own customers' progress (proposal ready, stage rejected,
# payment verified). Placeholder-registry entry A1 — unconfirmed; set false to stop.
# default: true
NOTIFY_ASSOCIATES=

# ── Notifications / observability ────────────────────────────────────────────
# Slack incoming-webhook URL for internal alerts; blank = log-only notifier.
SLACK_WEBHOOK_URL=
# Sentry DSN; blank = Sentry off. prod: https://<key>@o<org>.ingest.sentry.io/<project>
SENTRY_DSN=

# ── Customer memory (episodic recall + self-reflection) ──────────────────────
# true = also embed each memory and rank by meaning (one embedding call per memory/question).
# default: false
MEMORY_SEMANTIC_SEARCH=
# Embedding model used when semantic search is on.
# default: text-embedding-3-small
MEMORY_EMBEDDING_MODEL=
# How many memories a recall returns.
# default: 12
MEMORY_RECALL_TOP_K=
# Force a reflection after this many customer messages even if no milestone was hit.
# default: 12
MEMORY_REFLECT_EVERY_N_MESSAGES=

# ── Background work and scheduled jobs ───────────────────────────────────────
# Threads per instance for work done after the response (emails, receipts, PDFs,
# associate documents, reflections) — app/jobs/runner.py.
# default: 4
BACKGROUND_WORKERS=
# Sweepers in the scheduled jobs retry background work older than this (minutes)…
# default: 15
SWEEPER_GRACE_MINUTES=
# …at most this many items per run.
# default: 10
SWEEPER_BATCH_SIZE=
# check-stale-leads makes at most this many quiet-lead reflections (model calls) per run.
# default: 10
STALE_LEAD_REFLECTIONS_PER_RUN=
# GET /api/v1/health/ready reuses its answer for this many seconds (0 = never).
# default: 15
READINESS_CACHE_SECONDS=
# (The container's own variable, read by the Dockerfile CMD, not by the app) seconds
# uvicorn lets in-flight requests finish after SIGTERM; Cloud Run kills at 10.
# GRACEFUL_SHUTDOWN_SECONDS=8

# ── NeMo Guardrails (semantic disclosure check; one extra LLM call per reply) ─
# Requires LLM_API_KEY.
# default: false
NEMO_GUARDRAILS_ENABLED=
# Rail timeout (seconds).
# default: 6
NEMO_GUARDRAILS_TIMEOUT_SECONDS=
# On rail error/timeout: false sends the reply anyway (deterministic checks still run), true withholds it.
# default: false
NEMO_GUARDRAILS_FAIL_CLOSED=
# Rail checks that may run at once (one per concurrent customer reply).
# default: 4
NEMO_GUARDRAILS_MAX_WORKERS=
# (NeMo's own variable) The rail's OpenAI engine reads OPENAI_API_KEY; when it is unset the
# app fills it from LLM_API_KEY. Set it only to give the rail a different key.
# OPENAI_API_KEY=

# ── Agent governance ─────────────────────────────────────────────────────────
# Kill switch, no deploy needed. Valid ids: sales_agent, proposal_agent, memory_agent.
# default: []
DISABLED_AGENTS=
# Most agent replies one lead may receive in 24h before handing to a person. 0 disables.
# default: 60
AGENT_DAILY_ACTION_LIMIT_PER_LEAD=
# A run slower than this (ms) is logged as slow — a warning, not a cut-off.
# default: 8000
AGENT_SLOW_RUN_MS=

# ── Tests only (read by tests/conftest.py, not by the app) ───────────────────
# Opt-in: run the suite against this PostgreSQL. Use a DEDICATED throwaway database —
# every table in it is dropped around each test. Example: postgresql://postgres:postgres@localhost:5432/gridnova_test
# TEST_DATABASE_URL=
